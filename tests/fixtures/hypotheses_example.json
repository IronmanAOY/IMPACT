{
 "schema": "mpc-bench-hypotheses/1",
 "version": "example-1",
 "status": "example",
 "notes": "A small example hypotheses file for the evaluator tests. Its hypotheses show the file format; they belong to no analysis.",
 "conventions": {
  "alpha": 0.05,
  "false_present_bound": 0.07
 },
 "vocabulary": {
  "design.witnesses": [
   "A_witnesses",
   "C_witnesses"
  ],
  "design.factorial": [
   "A_factorial",
   "C_factorial"
  ],
  "design.adversarial": "A_adversaries",
  "design.twins": [
   "A_twins",
   "C_twins"
  ],
  "design.null_calibration": "null_calibration",
  "family.A": "A",
  "family.C": "C",
  "form.primary": [
   "primary",
   "directional"
  ],
  "form.iim_bidirectional": [
   "iim_bidirectional",
   "bidirectional"
  ],
  "view.source": "source",
  "protocol.A-R": "A-R",
  "protocol.A-H": "A-H",
  "protocol.C-R": "C-R",
  "protocol.C-H": "C-H",
  "systems.single_deficits": [
   "W_RAM_no_plasticity",
   "W_PDI_single_attractor",
